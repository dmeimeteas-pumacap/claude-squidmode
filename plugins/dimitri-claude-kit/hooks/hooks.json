{
  "description": "Continuity hooks: session-start thread briefing + expand-keyword prompt expansion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": ["/c", "${CLAUDE_PLUGIN_ROOT}/scripts/run-bash-hook.cmd", "session-start-global.sh"],
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe",
            "args": ["/c", "${CLAUDE_PLUGIN_ROOT}/scripts/run-bash-hook.cmd", "expand-prompt.sh"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
